<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hyper-V GPU Manager" Width="1180" Height="840" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#F3F5F9" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17243C"/><Setter Property="BorderBrush" Value="#CFD7E4"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="BorderBrush" Value="#CFD7E4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,12,8"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7F9FC"/><Setter Property="BorderBrush" Value="#DDE3ED"/><Setter Property="RowHeight" Value="34"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2354D7"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#41516B"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="WrappedCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,5"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="190"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <Border Background="#14223B" Padding="28,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="HYPER-V / GPU MANAGER" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Inspect your host. Configure with confidence. Keep recovery within reach." Foreground="#BCCBE4" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Name="Refresh" Content="Refresh host"/><Button Name="OpenLogs" Content="Open logs"/></StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Margin="24,18,24,12" Background="White" BorderBrush="#DDE3ED" Padding="18">
      <TabItem Header="  Overview  ">
        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Host readiness" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Name="HostSummary" Grid.Row="1" Text="Run Refresh host to inspect prerequisites, virtual machines and partitionable devices." TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#41516B"/>
          <DataGrid Name="Checks" Grid.Row="2" AutoGenerateColumns="False" RowHeight="NaN"><DataGrid.Columns><DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/><DataGridTextColumn Header="Details and next steps" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrappedCell}"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="  Virtual machines  ">
        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Virtual machines" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <DataGrid Name="Vms" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="vCPU" Binding="{Binding Cpu}" Width="65"/><DataGridTextColumn Header="Memory" Binding="{Binding Ram}" Width="90"/><DataGridTextColumn Header="Storage" Binding="{Binding Storage}" Width="100"/><DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="220"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="Select a VM here to use it in GPU and driver operations. Deletion requires confirmation." Foreground="#41516B" Margin="0,0,0,6"/><WrapPanel><CheckBox Name="DeleteFiles" Content="Also delete associated disk files"/><Button Name="DeleteVm" Content="Delete selected VM" Foreground="#AD2437"/></WrapPanel></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="  GPU and drivers  ">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
          <TextBlock Text="GPU assignment and driver maintenance" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Name="TargetLabel" Text="Select a target in the Virtual machines tab." Foreground="#2354D7" Margin="0,0,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Partitionable host device" Style="{StaticResource Label}"/><ComboBox Name="HostGpu" DisplayMemberPath="Name"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Allocation percentage (1-100)" Style="{StaticResource Label}"/><TextBox Name="Percent" Text="50"/></StackPanel>
          </Grid>
          <WrapPanel><Button Name="AssignGpu" Content="Assign / update GPU" Style="{StaticResource Primary}"/></WrapPanel>
          <Separator Margin="0,6,0,12"/>
          <TextBlock Text="Assigned GPU for maintenance" Style="{StaticResource Label}"/><ComboBox Name="AssignedGpu" DisplayMemberPath="Label"/>
          <TextBlock Text="Windows system disk (automatic probing checks for ambiguity)" Style="{StaticResource Label}"/><ComboBox Name="SystemDisk" DisplayMemberPath="Label"/>
          <WrapPanel><CheckBox Name="SkipExisting" Content="Skip files with matching hashes" IsChecked="True"/><CheckBox Name="CleanDrivers" Content="Clean tracked files when removing GPU"/></WrapPanel>
          <WrapPanel><Button Name="PlanDrivers" Content="Preview driver plan"/><Button Name="InstallDrivers" Content="Synchronize drivers" Style="{StaticResource Primary}"/><Button Name="AuditDrivers" Content="Check driver files"/><Button Name="RecoverDrivers" Content="Recover interrupted copy"/><Button Name="RemoveGpu" Content="Remove assignment"/></WrapPanel>
          <Border Background="#EBF2FF" Padding="12" Margin="0,8,0,0"><TextBlock Text="Share your existing host GPU with Windows guests using GPU-PV. Synchronize drivers after a host driver update. Keep the VM off during maintenance, then test the games or applications you want to run." TextWrapping="Wrap" Foreground="#274D89"/></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="  Create VM / profiles  ">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
          <TextBlock Text="Create once. Reuse your configuration." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Preset" Style="{StaticResource Label}"/><ComboBox Name="Preset"><ComboBoxItem Content="Development" IsSelected="True"/><ComboBoxItem Content="Gaming"/><ComboBoxItem Content="ML training"/><ComboBoxItem Content="Custom"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Saved profiles" Style="{StaticResource Label}"/><ComboBox Name="Profiles" DisplayMemberPath="Name"/></StackPanel>
          </Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="VM name" Style="{StaticResource Label}"/><TextBox Name="VmName" Text="Dev-VM"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="vCPU" Style="{StaticResource Label}"/><TextBox Name="Cpu" Text="4"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Memory (GiB)" Style="{StaticResource Label}"/><TextBox Name="Ram" Text="8"/></StackPanel>
            <StackPanel Grid.Column="6"><TextBlock Text="Disk size (GiB)" Style="{StaticResource Label}"/><TextBox Name="Storage" Text="128"/></StackPanel>
          </Grid>
          <TextBlock Text="Virtual disk directory" Style="{StaticResource Label}"/><TextBox Name="VhdDirectory" Text="C:\ProgramData\Microsoft\Windows\Virtual Hard Disks"/>
          <TextBlock Text="Windows installation ISO (optional)" Style="{StaticResource Label}"/>
          <DockPanel><Button Name="BrowseIso" Content="Browse..." DockPanel.Dock="Right"/><Button Name="ScanIso" Content="Read editions" DockPanel.Dock="Right"/><TextBox Name="IsoPath"/></DockPanel>
          <WrapPanel><CheckBox Name="AutoInstall" Content="Build unattended installation media (ADK)"/><CheckBox Name="OverwriteVhd" Content="Back up and replace existing VHD"/></WrapPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Installation image index (0 = manual)" Style="{StaticResource Label}"/><TextBox Name="ImageIndex" Text="0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Local setup username (optional)" Style="{StaticResource Label}"/><TextBox Name="Username"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Setup password (blank keeps saved profile password)" Style="{StaticResource Label}"/><PasswordBox Name="Password" Padding="9,7" Margin="0,4,0,12"/></StackPanel>
          </Grid>
          <TextBlock Name="ImageOptions" TextWrapping="Wrap" Foreground="#41516B" Margin="0,0,0,8"/>
          <Button Name="CreateVm" Content="Create virtual machine" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
          <Separator Margin="0,8,0,12"/>
          <TextBlock Text="Profile name" Style="{StaticResource Label}"/><TextBox Name="ProfileName"/>
          <WrapPanel><CheckBox Name="DefaultProfile" Content="Set as default"/><Button Name="SaveProfile" Content="Save / update profile"/><Button Name="DeleteProfile" Content="Delete profile"/><Button Name="MakeDefault" Content="Make default"/><Button Name="BackupConfig" Content="Back up profiles"/><Button Name="RestoreConfig" Content="Restore profiles"/></WrapPanel>
          <TextBlock Text="Saved passwords use Windows user encryption. Answer files and generated ISOs contain setup credentials; protect and remove that media after installation." TextWrapping="Wrap" Foreground="#765613"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="  Devices  "><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Host devices and GPU-PV capability" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid Name="Devices" Grid.Row="1" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Driver" Binding="{Binding DriverVersion}" Width="140"/><DataGridTextColumn Header="Partitionable" Binding="{Binding Partitionable}" Width="100"/><DataGridTextColumn Header="Class" Binding="{Binding DeviceClass}" Width="110"/><DataGridTextColumn Header="Compatibility" Binding="{Binding Compatibility}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="White" BorderBrush="#DDE3ED" BorderThickness="1,1,1,0" Margin="24,0">
      <Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><Button Name="ExportResult" Content="Save result..." DockPanel.Dock="Right" Padding="10,3"/><Button Name="Cancel" Content="Cancel safely" DockPanel.Dock="Right" Padding="10,3" IsEnabled="False"/><TextBlock Text="ACTIVITY AND RESULTS" FontWeight="SemiBold" Foreground="#41516B" VerticalAlignment="Center"/></DockPanel>
        <TextBox Name="Activity" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="#F7F9FC"/>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="#E8EDF5" Padding="24,10"><DockPanel><CheckBox Name="Shutdown" Content="Allow graceful shutdown of selected VM" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Name="Status" Text="Ready. No VM configuration has been changed." Foreground="#41516B"/></DockPanel></Border>
  </Grid>
</Window>
